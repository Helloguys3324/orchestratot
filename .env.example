# AutoGen AI Orchestrator Configuration
#
# Configuration settings are managed via environment variables and this .env file.
# Updating settings via the UI will automatically write to this .env file.
# Note: Legacy configuration from data/settings.json is automatically migrated to this file.

# The API key used for the language model (required if not using a local, unauthenticated model)
AUTOGEN_API_KEY=

# The model to use by default. Defaults to gemini-2.5-flash.
AUTOGEN_DEFAULT_MODEL=gemini-2.5-flash

# The model to use for the orchestrator router. Defaults to gemini-3-flash-live.
# AUTOGEN_ROUTER_MODEL=gemini-3-flash-live

# The base URL for the OpenAI-compatible API endpoint.
AUTOGEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── Optional Configuration ──────────────────────────────────

# The maximum number of conversational rounds allowed. Defaults to 15.
# AUTOGEN_MAX_ROUNDS=15 (Range: 1-100)

# The temperature parameter for model generation. Defaults to 0.7.
# AUTOGEN_TEMPERATURE=0.7 (Range: 0.0-2.0)

# The maximum tokens parameter for model generation. Defaults to 4096.
# AUTOGEN_MAX_TOKENS=4096 (Range: 1-128000)

# ─── Advanced Configuration ──────────────────────────────────

# The path to the custom .env configuration file. Defaults to .env in project root.
# AUTOGEN_ENV_FILE=

# The directory where runtime data (agents, sessions, skills) is stored.
# AUTOGEN_DATA_DIR=

# The directory where built-in skills are located.
# AUTOGEN_SKILLS_DIR=

# The directory where custom skills are stored.
# AUTOGEN_CUSTOM_SKILLS_DIR=

# The directory where the session workspace files are stored.
# AUTOGEN_WORKSPACE_DIR=
