# AutoGen AI Orchestrator Configuration
#
# Configuration settings prioritize environment variables (and this .env file) over
# the internal data/settings.json file. To permanently set a value that won't be
# overridden by UI changes, configure it here.

# The API key used for the language model (required if not using a local, unauthenticated model)
AUTOGEN_API_KEY=

# The model to use by default. Defaults to gemini-2.5-flash.
AUTOGEN_DEFAULT_MODEL=gemini-2.5-flash

# The base URL for the OpenAI-compatible API endpoint.
AUTOGEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── Optional Configuration ──────────────────────────────────

# The maximum number of conversational rounds allowed. Defaults to 15.
# AUTOGEN_MAX_ROUNDS=15

# The temperature parameter for model generation. Defaults to 0.7.
# AUTOGEN_TEMPERATURE=0.7

# The maximum tokens parameter for model generation. Defaults to 4096.
# AUTOGEN_MAX_TOKENS=4096
